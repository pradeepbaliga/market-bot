# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_chat_id_here

# Experiential Labs API key (Settings → API Keys at experientiallabs.ai)
EXPLABS_API_KEY=your_explabs_api_key_here

# ── Webhook security ──────────────────────────────────────────────────────────
WEBHOOK_SECRET=changeme_use_a_random_string

# ── Scheduler ─────────────────────────────────────────────────────────────────
BRIEF_HOUR=6
BRIEF_MINUTE=30
TIMEZONE=America/Los_Angeles

# ── Server (Railway sets PORT automatically) ──────────────────────────────────
# PORT=8000
